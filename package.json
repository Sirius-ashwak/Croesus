{
  "name": "croesus",
  "version": "0.1.0",
  "private": true,
  "description": "Croesus — Bitcoin treasury operating system on Mezo. \"Bitcoin, unlocked.\"",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "contracts:build": "pnpm --filter @croesus/contracts build",
    "contracts:test": "pnpm --filter @croesus/contracts test",
    "web:dev": "pnpm --filter @croesus/web dev"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
