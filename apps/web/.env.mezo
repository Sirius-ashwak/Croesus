# ─────────────────────────────────────────────────────────────────────────
# Mezo Testnet (matsnet, chain 31611) — LIVE Layer B deployment.
# Activate with:  pnpm env:mezo   (then restart the dev server)
# Revert to local anvil with:  pnpm env:anvil
#
# CroesusRegistry runs in "Mezo mode": registerOrganization deploys a per-org
# MezoBorrowAdapter over the real BorrowerOperations + TroveManager, and reads
# BTC/USD through MezoPriceFeedAdapter. Collateral is NATIVE BTC.
# Deployed 2026-05-24 from script/DeployMezo.s.sol.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=31611
NEXT_PUBLIC_MEZO_RPC=https://rpc.test.mezo.org
NEXT_PUBLIC_MEZO_EXPLORER=https://explorer.test.mezo.org

# Set a real id from https://cloud.walletconnect.com to enable WalletConnect /
# mobile wallets. Without it the app falls back to injected (extension) only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Croesus on matsnet (from DeployMezo) ──────────────────────────────────
NEXT_PUBLIC_REGISTRY_ADDRESS=0x29c203CaB55A0aCcD1B9974A6E5d84fdF3625d55
NEXT_PUBLIC_PYTH_ORACLE_ADDRESS=0xe9eB1F92d3609cC72dd9eAeDA0b5b41a91137cBf

# Per-org borrow provider (the adapter) is read from vault.mezoBorrow() at
# runtime, so this stays blank.
NEXT_PUBLIC_MEZO_BORROW_ADDRESS=

# ─── Real Mezo protocol tokens (matsnet) ───────────────────────────────────
NEXT_PUBLIC_MUSD_TOKEN_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
NEXT_PUBLIC_TBTC_TOKEN_ADDRESS=0x517f2982701695D4E52f1ECFBEf3ba31Df470161
NEXT_PUBLIC_BTC_USD_PRICE_FEED_ID=0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43

# Demo price OFF on testnet: the vault reads BTC/USD from Mezo's real PriceFeed
# on-chain. (Set a number here only if you want to force the frontend display.)
NEXT_PUBLIC_DEMO_BTC_PRICE_USD=
