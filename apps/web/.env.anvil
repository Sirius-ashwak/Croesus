# ─────────────────────────────────────────────────────────────────────────
# Local mocks-first dev — Anvil (chain 31337).
# Activate with:  pnpm env:anvil   (then restart the dev server)
#
# Addresses are deterministic for a fresh `anvil` +
# `pnpm --filter @croesus/contracts deploy:local` (deployer = anvil account #0).
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545

NEXT_PUBLIC_REGISTRY_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
NEXT_PUBLIC_MEZO_BORROW_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_MUSD_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_TBTC_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_PYTH_ORACLE_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
NEXT_PUBLIC_BTC_USD_PRICE_FEED_ID=0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43

# Demo price override keeps the UI working without hitting Pyth Hermes (R-02).
NEXT_PUBLIC_DEMO_BTC_PRICE_USD=74800
